# =====================================================
# server/.env.example - SAFE to commit.
# This is a TEMPLATE. Copy it to .env and fill in real
# values. Never put real secrets in this template.
# =====================================================

# MongoDB connection string from MongoDB Atlas
# Looks like:
# mongodb+srv://USER:PASSWORD@cluster0.xxxx.mongodb.net/ai-wedding?retryWrites=true&w=majority
MONGODB_URI=YOUR_MONGODB_CONNECTION_STRING

# OpenRouter API key (get a free key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# OpenRouter model identifier.
# "openrouter/free" = OpenRouter's FREE model router. Free means NOT unlimited:
# it has lower rate limits, may be unavailable at times, and OpenRouter picks
# whichever free model fits your request (you can't choose the exact model).
# Swap for any other model ID if you add credits, e.g. openai/gpt-4o
# or anthropic/claude-3.5-sonnet.
OPENROUTER_MODEL=openrouter/free

# Server port
PORT=5000

# Frontend URL for CORS (local development)
CLIENT_URL=http://localhost:5173